Only build/run the ALSA hotplug regression test when tests are enabled.
Upstream wires rtmidi_hotplug_check as an ALL custom target, so it runs on
every build including 'install'; the test opens /dev/snd/seq, which the
Portage sandbox denies, aborting src_install. Gate it on
RTMIDI_BUILD_TESTING like every other test program.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -362,8 +362,8 @@
   endif()
 endif()
 
-# Compile and run hotplug regression tests whenever the ALSA library is built.
-if("alsa" IN_LIST API_LIST)
+# Compile and run hotplug regression tests only when tests are enabled.
+if(RTMIDI_BUILD_TESTING AND "alsa" IN_LIST API_LIST)
   include(tests/AlsaHotplug.cmake)
   rtmidi_add_hotplug_test(rtmidi "${CMAKE_CURRENT_SOURCE_DIR}")
 endif()
